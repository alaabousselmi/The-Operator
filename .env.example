# Copy to .env (git-ignored) and fill in. Never commit a real key.
GROQ_API_KEY=
OPERATOR_MODEL=groq:openai/gpt-oss-120b
# Optional: more keys for the parallel eval (python -m eval.run_team). One slice per key.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# ---- LangSmith tracing (smith.langchain.com, free plan) ----
# Paste your LangSmith API key after the = sign. While it is empty, tracing stays off
# and nothing is sent.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=the-operator
# Only if your LangSmith account is in the EU region, remove the # on the next line:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
