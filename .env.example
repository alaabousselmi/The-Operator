# Copy to .env (git-ignored) and fill in. Never commit a real key.
GROQ_API_KEY=
OPERATOR_MODEL=groq:openai/gpt-oss-120b
# Optional: more keys for the parallel eval (python -m eval.run_team). One slice per key.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Optional: LangSmith tracing (smith.langchain.com, free plan). When set, every run and
# every eval scenario is traced, with its scores. Leave LANGSMITH_TRACING=false to send nothing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=the-operator
# Accounts in the EU region also need: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
